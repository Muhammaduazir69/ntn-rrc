+                    }
+                }
+            }
+            for (int i = 0; i < 6; ++i)
+            {
+                for (int j = 0; j < 6; ++j)
+                {
+                    nP[i][j] = 0.0;
+                    for (int l = 0; l < 6; ++l)
+                    {
+                        nP[i][j] += FP[i][l] * F[j][l];
+                    }
+                }
+            }
+            const double q = sigmaA * sigmaA;
+            for (int i = 0; i < 3; ++i)
+            {
+                nP[i][i] += q * h * h * h * h / 4.0;
+                nP[i + 3][i + 3] += q * h * h;
+                nP[i][i + 3] += q * h * h * h / 2.0;
+                nP[i + 3][i] += q * h * h * h / 2.0;
+            }
+            std::copy(&nP[0][0], &nP[0][0] + 36, &m_P[0][0]);
+            auto f = [](const double* y, double* d) {
