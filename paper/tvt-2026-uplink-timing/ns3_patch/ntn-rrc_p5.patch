+double
+NtnSib19Broadcaster::ServedAge(double v) const
+{
+    if (m_budgetLegacy)
+    {
+        return v;
+    }
+    // longest view above the mask, for an overhead pass with the Earth turning the same way
+    constexpr double kMu = 3.986004418e14;
+    constexpr double kRe = 6378137.0;
+    constexpr double kOmegaE = 7.2921150e-5;
+    const Vector p = m_sat->GetPosition();
+    const double r = std::sqrt(p.x * p.x + p.y * p.y + p.z * p.z);
+    const double m = m_maskDeg * M_PI / 180.0;
+    const double phi = std::acos(kRe * std::cos(m) / r) - m;
+    const double dwell = 2.0 * phi / (std::sqrt(kMu / (r * r * r)) - kOmegaE);
+    return std::min(v, dwell + m_period.GetSeconds());
+}
+
+double
+NtnSib19Broadcaster::UeAllowanceAt(double v) const
+{
+    double a = m_ueAllowance.GetSeconds();
+    if (m_gnssSigma > 0.0)
+    {
+        // two-sided quantile of deltaG / N by bisection on erfc(z / sqrt 2) = deltaG / N
+        const double n = std::max(1.0, std::ceil((ServedAge(v) + m_lead) / m_gnssPeriod));
+        const double target = m_gnssDelta / n;
+        double lo = 0.0;
+        double hi = 10.0;
+        for (int i = 0; i < 60; ++i)
+        {
+            const double z = 0.5 * (lo + hi);
+            (std::erfc(z / std::sqrt(2.0)) > target ? lo : hi) = z;
+        }
+        a += 2.0 * 0.5 * (lo + hi) * m_gnssSigma / NtnTimingAdvance::kSpeedOfLight;
+    }
+    return a;
+}
