+            Predict(t - m_t, sigmaA);
+            double A[6][12]; // Gauss-Jordan on [P + R | P]: right block becomes (P + R)^-1 P = K^T
+            for (int i = 0; i < 6; ++i)
+            {
+                for (int j = 0; j < 6; ++j)
+                {
+                    A[i][j] = m_P[i][j] + (i == j ? (i < 3 ? rp : rv) : 0.0);
+                    A[i][j + 6] = m_P[i][j];
+                }
+            }
+            for (int i = 0; i < 6; ++i)
+            {
+                int piv = i;
+                for (int k = i + 1; k < 6; ++k)
