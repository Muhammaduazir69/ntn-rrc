+    double a = 1.0 / (2.0 / rn - v2 / kMu);
+    const double hx = r[1] * u[2] - r[2] * u[1];
+    const double hy = r[2] * u[0] - r[0] * u[2];
+    const double hz = r[0] * u[1] - r[1] * u[0];
+    const double hn = std::sqrt(hx * hx + hy * hy + hz * hz);
