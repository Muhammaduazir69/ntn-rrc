+void
+QuantizeOrbital(Vector& p, Vector& v)
+{
+    double r[3] = {p.x, p.y, p.z};
+    double u[3] = {v.x - kOmegaE * p.y, v.y + kOmegaE * p.x, v.z}; // ECEF velocity -> inertial
